<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Convertr.Svc</RootNamespace>
    <AssemblyName>convertr-svc</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(ConvertrCoreProject)" />
  </ItemGroup>
  <ItemGroup>
    <!-- the web UI is embedded in the binary (single file); served by StaticUi. CONVERTR_WWWROOT serves from disk instead (development). -->
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Convertr.Svc.Tests" />
  </ItemGroup>
</Project>
